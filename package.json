{
  "name": "@gg-utils/worktree-core",
  "version": "0.2.0",
  "description": "Product-neutral worktree stack primitives for branch prefixes and worktree helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prefix": {
      "types": "./dist/prefix.d.ts",
      "default": "./dist/prefix.js"
    },
    "./package.json": "./package.json",
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./git-branches": {
      "types": "./dist/git-branches.d.ts",
      "default": "./dist/git-branches.js"
    },
    "./git-worktree-sync": {
      "types": "./dist/git-worktree-sync.d.ts",
      "default": "./dist/git-worktree-sync.js"
    },
    "./repo-locks": {
      "types": "./dist/repo-locks.d.ts",
      "default": "./dist/repo-locks.js"
    },
    "./worktree-discovery": {
      "types": "./dist/worktree-discovery.d.ts",
      "default": "./dist/worktree-discovery.js"
    },
    "./shell-shim": {
      "types": "./dist/shell-shim.d.ts",
      "default": "./dist/shell-shim.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/**/*.unit.test.js\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "sh scripts/check-dist.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/worktree-core.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
